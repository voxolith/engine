{
  "name": "@voxolith/engine",
  "version": "0.1.0",
  "description": "Voxolith entities: the model + role contract, the generator registry, a headless authoring toolkit and a CPU preview renderer",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxolith/engine.git"
  },
  "homepage": "https://github.com/voxolith/engine#readme",
  "bugs": "https://github.com/voxolith/engine/issues",
  "keywords": [
    "voxel",
    "entity",
    "procedural",
    "generator",
    "webgpu",
    "voxolith"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker/index.ts",
    "./build": "./src/build/index.ts",
    "./preview": "./src/preview/index.ts",
    "./vox": "./src/vox.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "bun tools/verify.ts"
  },
  "dependencies": {
    "@voxolith/renderer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
